# Configuration Synapse durcie pour Kibaré.
# Modèle rendu par admin-console/scripts/init_secrets.py : les variables
# ${...} sont remplacées par les paramètres de .env et les secrets générés.

server_name: "${SERVER_NAME}"
public_baseurl: "${MATRIX_PUBLIC_URL}/"
pid_file: /data/homeserver.pid
signing_key_path: /data/signing.key
media_store_path: /data/media_store
log_config: /rendered/synapse/log.config
report_stats: false

# --- Écoute : API client uniquement, PAS de fédération -----------------------
listeners:
  - port: 8008
    type: http
    tls: false
    x_forwarded: true
    bind_addresses: ["0.0.0.0"]
    resources:
      - names: [client]
        compress: false

# Aucun autre serveur Matrix n'est autorisé à communiquer avec celui-ci,
# et aucun serveur de clés externe (matrix.org) n'est consulté.
federation_domain_whitelist: []
trusted_key_servers: []
suppress_key_server_warning: true
allow_public_rooms_over_federation: false

database:
  name: psycopg2
  args:
    user: synapse
    password: "${SYNAPSE_DB_PASSWORD}"
    database: synapse
    host: postgres
    cp_min: 5
    cp_max: 10

macaroon_secret_key: "${SYNAPSE_MACAROON_SECRET}"
form_secret: "${SYNAPSE_FORM_SECRET}"
# Utilisé uniquement par la console pour créer son compte de service.
registration_shared_secret: "${SYNAPSE_REGISTRATION_SECRET}"

# --- Identité vérifiée --------------------------------------------------------
# Aucune inscription libre, aucun invité, aucune connexion par mot de passe
# Matrix : la seule porte d'entrée est Keycloak (mot de passe + TOTP).
enable_registration: false
allow_guest_access: false
password_config:
  enabled: false

oidc_providers:
  - idp_id: keycloak
    idp_name: "Identité de l'administration (MTDPCE)"
    # Le navigateur passe par l'URL publique ; Synapse parle à Keycloak
    # directement sur le réseau interne Docker.
    issuer: "${KEYCLOAK_PUBLIC_URL}/realms/mtdpce"
    discover: false
    authorization_endpoint: "${KEYCLOAK_PUBLIC_URL}/realms/mtdpce/protocol/openid-connect/auth"
    token_endpoint: "http://keycloak:8080/realms/mtdpce/protocol/openid-connect/token"
    userinfo_endpoint: "http://keycloak:8080/realms/mtdpce/protocol/openid-connect/userinfo"
    jwks_uri: "http://keycloak:8080/realms/mtdpce/protocol/openid-connect/certs"
    client_id: synapse
    client_secret: "${SYNAPSE_OIDC_SECRET}"
    client_auth_method: client_secret_post
    # Keycloak exige PKCE (S256) ; sans découverte, "auto" ne l'enverrait pas.
    pkce_method: always
    scopes: ["openid", "profile"]
    # Démo locale en HTTP ; en production, HTTPS et skip_verification: false.
    skip_verification: true
    # Les comptes sont pré-créés par la console à l'enrôlement.
    allow_existing_users: true
    # Seuls les porteurs du rôle "agent" peuvent ouvrir une session.
    attribute_requirements:
      - attribute: roles
        value: agent
    user_mapping_provider:
      config:
        localpart_template: "{{ user.preferred_username }}"
        display_name_template: "{{ user.name }}"

# --- Chiffrement de bout en bout imposé --------------------------------------
encryption_enabled_by_default_for_room_type: all

# --- Minimisation des métadonnées --------------------------------------------
presence:
  enabled: false
url_preview_enabled: false
require_auth_for_profile_requests: true
limit_profile_requests_to_users_who_share_rooms: true
include_profile_data_on_invite: false
allow_public_rooms_without_auth: false
user_directory:
  enabled: true
  search_all_users: true
  prefer_local_users: true
push:
  include_content: false
# Durées de conservation courtes des traces techniques.
user_ips_max_age: 1d
redaction_retention_period: 1d
forget_rooms_on_leave: true

# Expiration automatique des messages (utilisée par les salons classifiés).
retention:
  enabled: true
  purge_jobs:
    - interval: 15m

max_upload_size: 50M
enable_metrics: false
