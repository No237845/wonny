# Paramètres publics du déploiement (aucun secret ici : les secrets sont
# générés automatiquement au premier démarrage par le service "init").

# Nom d'hôte par lequel les navigateurs joignent la plateforme.
PUBLIC_HOST=localhost

# Nom de domaine Matrix des comptes (@prenom.nom:SERVER_NAME).
SERVER_NAME=kibare.local

# Ports exposés
PORT_MATRIX=8008
PORT_ELEMENT=8080
PORT_KEYCLOAK=8180
PORT_TUNNEL=8000

# Adresse publique unique d'Element, Synapse et Keycloak :
#   https://PUBLIC_HOST          HTTPS servi par Caddy (ports 443 et 80) ;
#   https://….ngrok-free.app     tunnel de démonstration vers 127.0.0.1:PORT_TUNNEL
#                                (il voit mots de passe et TOTP : comptes fictifs) ;
#   vide                         accès HTTP local par les ports ci-dessus.
# Après un changement : scripts/appliquer-adresse-publique.sh
PUBLIC_URL=https://localhost

# Certificat HTTPS de Caddy : "internal" (autorité locale, démonstration),
# "/certs/kibare.crt /certs/kibare.key" (certificat de l'État déposé dans
# config/caddy/certs/), ou une adresse e-mail pour ACME.
CADDY_TLS=internal

PORT_CONSOLE=8090
